    "custom_liquid_zpLFtP": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% assign featured_collection = collections['featured-products'] %}\n\n<section class=\"gymkitz-featured-section\">\n  <div class=\"gymkitz-featured-heading\">\n    <h2>Featured Products</h2>\n\n    <div class=\"gymkitz-carousel-buttons\">\n      <button\n        type=\"button\"\n        class=\"gymkitz-arrow\"\n        onclick=\"gymkitzMoveCarousel(-1)\"\n        aria-label=\"Previous products\"\n      >\n        ‹\n      </button>\n\n      <button\n        type=\"button\"\n        class=\"gymkitz-arrow\"\n        onclick=\"gymkitzMoveCarousel(1)\"\n        aria-label=\"Next products\"\n      >\n        ›\n      </button>\n    </div>\n  </div>\n\n  <div class=\"gymkitz-product-carousel\" id=\"gymkitzProductCarousel\">\n\n    {% for product in featured_collection.products limit: 12 %}\n\n      <a href=\"{{ product.url }}\" class=\"gymkitz-product-card\">\n\n        <div class=\"gymkitz-product-image\">\n          {% if product.featured_image %}\n            {{\n              product.featured_image\n              | image_url: width: 800\n              | image_tag:\n                loading: 'lazy',\n                alt: product.title\n            }}\n          {% endif %}\n        </div>\n\n        <div class=\"gymkitz-product-info\">\n          <h3>{{ product.title }}</h3>\n\n          <div class=\"gymkitz-price\">\n            {% if product.compare_at_price > product.price %}\n              <span class=\"gymkitz-sale-price\">\n                {{ product.price | money }}\n              </span>\n\n              <span class=\"gymkitz-old-price\">\n                {{ product.compare_at_price | money }}\n              </span>\n            {% else %}\n              {{ product.price | money }}\n            {% endif %}\n          </div>\n        </div>\n\n      </a>\n\n    {% endfor %}\n\n  </div>\n</section>\n\n<style>\n\n.gymkitz-featured-section {\n  width: 100%;\n  padding: 48px 24px;\n  box-sizing: border-box;\n  background: transparent;\n}\n\n.gymkitz-featured-heading {\n  max-width: 1400px;\n  margin: 0 auto 24px;\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  gap: 20px;\n}\n\n.gymkitz-featured-heading h2 {\n  margin: 0;\n  color: #ffffff;\n  font-size: 34px;\n  line-height: 1.1;\n  font-weight: 700;\n}\n\n.gymkitz-carousel-buttons {\n  display: flex;\n  gap: 10px;\n}\n\n.gymkitz-arrow {\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  border: 1px solid #ffffff;\n  background: transparent;\n  color: #ffffff;\n  font-size: 28px;\n  line-height: 1;\n  cursor: pointer;\n  transition: 0.2s ease;\n}\n\n.gymkitz-arrow:hover {\n  background: #ffffff;\n  color: #071633;\n}\n\n.gymkitz-product-carousel {\n  max-width: 1400px;\n  margin: 0 auto;\n  display: flex;\n  gap: 18px;\n  overflow-x: auto;\n  scroll-behavior: smooth;\n  scroll-snap-type: x mandatory;\n  scrollbar-width: none;\n  -ms-overflow-style: none;\n  padding-bottom: 6px;\n}\n\n.gymkitz-product-carousel::-webkit-scrollbar {\n  display: none;\n}\n\n.gymkitz-product-card {\n  flex: 0 0 calc(25% - 14px);\n  min-width: 0;\n  text-decoration: none;\n  color: #ffffff;\n  scroll-snap-align: start;\n  background: transparent;\n}\n\n.gymkitz-product-image {\n  width: 100%;\n  aspect-ratio: 1 / 1;\n  overflow: hidden;\n  background: transparent;\n  border-radius: 14px;\n}\n\n.gymkitz-product-image img {\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n  transition: transform 0.3s ease;\n}\n\n.gymkitz-product-card:hover .gymkitz-product-image img {\n  transform: scale(1.035);\n}\n\n.gymkitz-product-info {\n  padding: 14px 4px 0;\n  background: transparent;\n}\n\n.gymkitz-product-info h3 {\n  margin: 0 0 6px;\n  color: #ffffff;\n  font-size: 17px;\n  line-height: 1.3;\n  font-weight: 600;\n}\n\n.gymkitz-price {\n  color: #ffffff;\n  font-size: 15px;\n}\n\n.gymkitz-sale-price {\n  color: #ffffff;\n  font-weight: 700;\n}\n\n.gymkitz-old-price {\n  margin-left: 7px;\n  color: #ffffff;\n  opacity: 0.55;\n  text-decoration: line-through;\n}\n\n@media screen and (max-width: 990px) {\n\n  .gymkitz-product-card {\n    flex: 0 0 calc(50% - 9px);\n  }\n\n}\n\n@media screen and (max-width: 749px) {\n\n  .gymkitz-featured-section {\n    padding: 36px 16px;\n  }\n\n  .gymkitz-featured-heading {\n    margin-bottom: 18px;\n  }\n\n  .gymkitz-featured-heading h2 {\n    font-size: 27px;\n  }\n\n  .gymkitz-product-card {\n    flex: 0 0 calc(50% - 7px);\n  }\n\n  .gymkitz-product-carousel {\n    gap: 14px;\n  }\n\n  .gymkitz-arrow {\n    width: 38px;\n    height: 38px;\n    font-size: 24px;\n  }\n\n  .gymkitz-product-info h3 {\n    font-size: 15px;\n  }\n\n}\n\n/* COLLECTION TITLES - match Featured Products carousel */\n\n.collection-card__title,\n.collection-card__title a,\n.collection-card .card__heading,\n.collection-card .card__heading a,\n.collection-list .card__heading,\n.collection-list .card__heading a,\n.card__heading,\n.card__heading a {\n  font-family: \"Poppins\", sans-serif !important;\n  color: #ffffff !important;\n  background: transparent !important;\n  font-size: 17px !important;\n  font-weight: 600 !important;\n  line-height: 1.3 !important;\n}\n\n/* Remove coloured/pink background behind collection names */\n.collection-card__content,\n.collection-card__information,\n.collection-card .card__content,\n.collection-card .card__information,\n.collection-list .card__content,\n.collection-list .card__information {\n  background: transparent !important;\n}\n\n/* Make any nested title text white */\n.collection-card__title *,\n.collection-card .card__heading *,\n.collection-list .card__heading * {\n  color: #ffffff !important;\n  background: transparent !important;\n}\n</style>\n\n<script>\n\nfunction gymkitzMoveCarousel(direction) {\n  const carousel = document.getElementById('gymkitzProductCarousel');\n\n  if (!carousel) return;\n\n  const card = carousel.querySelector('.gymkitz-product-card');\n\n  if (!card) return;\n\n  const gap = 18;\n  const scrollAmount = card.offsetWidth + gap;\n\n  carousel.scrollBy({\n    left: scrollAmount * direction,\n    behavior: 'smooth'\n  });\n}\n\n</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
